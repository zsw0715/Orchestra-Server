# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_BASIC_MODEL="deepseek-v4-flash"
DEEPSEEK_ADVANCED_MODEL="deepseek-v4-pro"
# --- Kimi (Moonshot AI) ---
MOONSHOT_API_KEY=sk-your-key
MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
MOONSHOT_BASIC_MODEL="kimi-k2.5"
MOONSHOT_ADVANCED_MODEL="kimi-k2.6"
# --- 智谱AI (GLM) ---
ZHIPUAI_API_KEY=your-key
ZHIPUAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"
ZHIPUAI_BASIC_MODEL="glm-5-turbo"
ZHIPUAI_ADVANCED_MODEL="glm-5.1"
# --- 阿里云通义千问 (DashScope) ---
DASHSCOPE_API_KEY=sk-your-key
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_BASIC_MODEL="qwen3.6-35b-a3b"
DASHSCOPE_ADVANCED_MODEL="qwen3.6-plus"
# --- Tavily ---
TAVILY_API_KEY=your-tavily-api-key
# === 用于长网页提炼的轻量模型 配置
WEB_FETCH_SUMMARIZE_MODEL="deepseek-v4-flash"
WEB_FETCH_SUMMARIZE_MODEL_API_KEY=sk-your-key
WEB_FETCH_SUMMARIZE_MODEL_BASE_URL=your-selected-model-base-url
# === LangSmith ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT="my code agent"
# === 数据库（可选：不配则用内存存储，重启丢失对话） ===
DATABASE_URL=postgresql://shenweizhang@localhost:5432/orchestra
# === 外挂知识库（workspace directory） === >> agent 的文件读写、shell 执行都限定在此目录下，默认使用服务器启动目录，前端可通过请求参数覆盖此值，让每个对话指向不同的用户项目
WORKSPACE_DIR="your-external-knowledge-base-dir"